{
  "manifest_version": 3,
  "name": "每日循環儀表板",
  "version": "1.0.0",
  "description": "極簡主義的每日規劃、衝刺與回顧工具",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "scripting",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "每日循環儀表板"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "commands": {
    "quick_capture": {
      "suggested_key": {
        "default": "Alt+K",
        "mac": "MacCtrl+K"
      },
      "description": "閃電捕捉 (Quick Capture) - 快速新增任務"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
} 