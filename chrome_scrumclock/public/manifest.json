{
  "manifest_version": 3,
  "name": "Power Kit",
  "version": "1.0.0",
  "description": "極簡主義的每日規劃、衝刺與回顧工具",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "scripting",
    "declarativeNetRequest",
    "downloads",
    "sidePanel",
    "contextMenus",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Power Kit"
  },
  "side_panel": {
    "default_path": "src/entries/sidebar/index.html"
  },
  "chrome_url_overrides": {
    "newtab": "src/entries/newtab/index.html"
  },
  "commands": {
    "quick_capture": {
      "suggested_key": {
        "default": "Alt+K",
        "mac": "MacCtrl+K"
      },
      "description": "閃電捕捉 (Quick Capture) - 快速新增任務"
    }
  },
  "options_page": "src/entries/options/index.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["geminiContent.js"],
      "run_at": "document_end"
    }
  ]
} 